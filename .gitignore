# --- Generated reports (gaudi_jobs/calibration/list_run_thresholds.py --output) ---
gaudi_jobs/calibration/run_thresholds*.txt
gaudi_jobs/run000166/logs
gaudi_jobs/run000167/logs

# --- Job stdout/stderr. The per-run "logs" rules above are path-specific: a
#     pipeline.out was committed once from a directory they did not cover, so
#     match the extensions everywhere instead (Condor writes .out/.err per job). ---
*.out
*.err


# --- Generated Condor pipeline artifacts (gaudi_jobs/calibration/condor/generate_*.py) ---
gaudi_jobs/calibration/condor/generated/
gaudi_jobs/condor/generated/

# --- Local machine config: settings.yml holds your private paths, so it is NOT
#     versioned. Copy settings.example.yml -> settings.yml and edit per machine. ---
settings.yml

# --- Editor / OS noise ---
*~
.DS_Store
.vscode/
.idea/

# build artifacts
build/
k4SiWEcalReco/build/

# Diagnostic PLOTS are local scratch and are not versioned. The scripts that make
# them are: they are the measurements the calibration constants come from (the
# switch point, k, c, the th220 MIP decision), and a constant whose derivation has
# been deleted is a magic number. Same for the procedure note.
diagnostics/*
!diagnostics/*.py
!diagnostics/*.txt

# Private credential (grid/condor token) -- must never be tracked
marquezh.cc

# Agent scratch files (claude_orders.txt and friends are covered by the glob)
.claude/
claude*

# Core dumps: two empty ones were committed once (bc3a911). "core.*" misses a
# bare "core", which is what the kernel writes when core_pattern has no suffix.
core
core.*